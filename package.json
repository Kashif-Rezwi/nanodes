{
  "name": "nanodes",
  "version": "0.0.0",
  "private": true,
  "description": "Dependency-free animated glyph text and images for the web.",
  "type": "module",
  "license": "MIT",
  "author": "Kashif Rezwi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kashif-Rezwi/nanodes.git"
  },
  "homepage": "https://github.com/Kashif-Rezwi/nanodes#readme",
  "bugs": {
    "url": "https://github.com/Kashif-Rezwi/nanodes/issues"
  },
  "keywords": [
    "animation",
    "ascii",
    "unicode",
    "glyphs",
    "typography",
    "svg",
    "framework-agnostic"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "reference": "node scripts/reference.mjs",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "site:check": "npm --prefix site run typecheck"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
